# Copy this to .env and fill in real values -- .env itself is gitignored,
# this example file is the only one checked in.

# Django
POKER_SECRET_KEY=change-me-to-something-random
POKER_DEBUG=true
POKER_ALLOWED_HOSTS=localhost,127.0.0.1

# Postgres -- also read directly by the db service in docker-compose.yml
# to set up the same database/user/password inside the container.
POKER_DB_NAME=pokerbot
POKER_DB_USER=pokerbot
POKER_DB_PASSWORD=pokerbot
# Overridden to "db" by docker-compose.yml itself when running in Docker --
# only matters here for running manage.py directly against the host.
POKER_DB_HOST=localhost
POKER_DB_PORT=5432

# Redis -- same deal, docker-compose.yml overrides this to "redis".
POKER_REDIS_HOST=127.0.0.1
POKER_REDIS_PORT=6379
